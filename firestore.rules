rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Общий чат: читать может любой, писать только игроки с подтверждённой почтой
    match /chat_messages/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 120
                    && request.resource.data.username is string
                    && request.resource.data.username.size() <= 20;
      allow update, delete: if false;
    }

    // Профиль и прогресс: каждый видит и меняет только свой документ,
    // и только после подтверждения почты (Google-аккаунты подтверждены сразу)
    match /users/{uid} {
      allow read: if request.auth != null
                  && request.auth.uid == uid
                  && request.auth.token.email_verified == true;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.auth.token.email_verified == true
                            && request.resource.data.keys().hasOnly(['nick', 'createdAt', 'savedAt', 'sid', 'sub', 'tg', 'state'])
                            && request.resource.data.nick is string
                            && request.resource.data.nick.size() >= 1
                            && request.resource.data.nick.size() <= 20
                            && (!('state' in request.resource.data)
                                || (request.resource.data.state is string
                                    && request.resource.data.state.size() < 1000000));
      allow delete: if false;
    }

    // Всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
